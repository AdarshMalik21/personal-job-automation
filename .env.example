# Copy to backend/.env for local development. Do not commit real secrets.
# NODE_ENV=production requires every value below to be set explicitly.
NODE_ENV=development
PORT=5000
# Include the database name in the path. The existing Atlas data is in the database named test.
MONGODB_URI=mongodb://127.0.0.1:27017/personal_job_automation
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-development-password
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
# Daily report notifications. Unset or "log" writes the report to the worker log.
# Do not add SMTP credentials. Email delivery is not configured, and NOTIFICATION_PROVIDER=smtp
# fails the send instead of recording a successful email.
# NOTIFICATION_PROVIDER=log
# Naukri discovery. Enabled unless NAUKRI_ENABLED=false. No Naukri login is required.
# NAUKRI_ENABLED=true
# NAUKRI_MAX_PAGES=5
# NAUKRI_MAX_JOBS_PER_QUERY=50
# NAUKRI_REQUEST_TIMEOUT_MS=15000
# NAUKRI_QUERIES=MERN Developer,Full Stack Developer
# NAUKRI_LOCATIONS=Delhi,Noida,Greater Noida,Gurgaon,Gurugram,Delhi NCR,Remote