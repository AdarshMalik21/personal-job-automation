NODE_ENV=development
PORT=5000
# Include the database name in the path. Existing Atlas jobs are in the database named test.
MONGODB_URI=mongodb://127.0.0.1:27017/personal_job_automation
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-secret
